{
  "fields": [
    {
      "name": "person",
      "type": "string",
      "description": "The id of the person in the people register.",
      "constraints": {
        "required": true,
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      }
    },
    {
      "name": "role",
      "type": "string",
      "description": "Whether the person is a voting or a non-voting member.",
      "constraints": {
        "required": true,
        "enum": [
          "voting",
          "non-voting"
        ]
      }
    },
    {
      "name": "source",
      "type": "string",
      "description": "A public record, linked as a web address, that supports the row.",
      "constraints": {
        "required": true,
        "pattern": ".*https?://.*"
      }
    },
    {
      "name": "notes",
      "type": "string",
      "description": "Free-text remarks on the row."
    }
  ],
  "foreignKeys": [
    {
      "fields": [
        "person"
      ],
      "reference": {
        "resource": "people",
        "fields": [
          "id"
        ]
      }
    }
  ]
}
