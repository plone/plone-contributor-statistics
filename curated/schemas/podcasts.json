{
  "fields": [
    {
      "name": "series",
      "type": "string",
      "description": "The podcast series.",
      "constraints": {
        "required": true
      }
    },
    {
      "name": "person",
      "type": "string",
      "description": "The id of the host in the people register; empty when the source names no host.",
      "constraints": {
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      }
    },
    {
      "name": "episodes",
      "type": "integer",
      "description": "The number of episodes the person took part in.",
      "constraints": {
        "required": true,
        "minimum": 1
      }
    },
    {
      "name": "source",
      "type": "string",
      "description": "A public record, linked as a web address, that supports the row.",
      "constraints": {
        "required": true,
        "pattern": ".*https?://.*"
      }
    },
    {
      "name": "notes",
      "type": "string",
      "description": "Free-text remarks on the row."
    }
  ],
  "foreignKeys": [
    {
      "fields": [
        "person"
      ],
      "reference": {
        "resource": "people",
        "fields": [
          "id"
        ]
      }
    }
  ]
}
